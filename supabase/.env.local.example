# ---------------------------------------------------------------------------
#  Segredos da Edge Function `chat`.
#  Usado apenas por `supabase functions serve --env-file supabase/.env.local`.
#  Em produção estes valores vão para os secrets do projeto, não para um arquivo.
# ---------------------------------------------------------------------------

# Chave do Gemini (https://aistudio.google.com/apikey). Nunca vai ao navegador.
GEMINI_API_KEY=AIza...

# Opcional: modelo usado. Padrão gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Número que recebe as propostas, só dígitos com código do país.
WHATSAPP_NUMBER=5585988661417

# Domínios autorizados a chamar a função, separados por vírgula.
# Vazio libera qualquer origem — use apenas em desenvolvimento.
ALLOWED_ORIGINS=http://localhost:3000

# Sal do hash usado no rate limit por IP. Troque por um valor aleatório.
RATE_LIMIT_SALT=troque-este-valor

# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente pelo
# runtime das Edge Functions. Só defina manualmente se rodar fora dele.
