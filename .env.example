# ---------------------------------------------------------------------------
#  Variáveis públicas do front-end (Next).
#  Só entram aqui valores que podem aparecer no navegador.
# ---------------------------------------------------------------------------

# URL do projeto Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave anônima. É pública por natureza: com RLS fechado ela não lê nem
# escreve nada no banco, só permite invocar a Edge Function.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Número do WhatsApp que recebe as propostas: só dígitos, com código do país.
NEXT_PUBLIC_WHATSAPP_NUMBER=5585988661417

# Opcional. Aponta o widget para a função rodando localmente:
# NEXT_PUBLIC_CHAT_ENDPOINT=http://127.0.0.1:54321/functions/v1/chat

# NUNCA coloque GEMINI_API_KEY nem SERVICE_ROLE_KEY neste arquivo.
# Tudo com prefixo NEXT_PUBLIC_ é embutido no bundle e fica visível.
